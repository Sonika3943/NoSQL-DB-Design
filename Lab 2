1. RDBMS vs. NoSQL Document Model Comparison
  #MySQL Implementation:
  CREATE DATABASE CollegeDB;
  USE CollegeDB;

  CREATE TABLE Students (
    Student_ID INT PRIMARY KEY,
    Name VARCHAR(50),
    Course VARCHAR(50),
    Semester INT,
    Marks DECIMAL(5,2)
);

